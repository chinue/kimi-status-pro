{
  "name": "kimi-status-pro",
  "displayName": "KimiStatusPro",
  "description": "Monitor Kimi Code quota usage in real-time",
  "version": "0.1.10",
  "publisher": "kayuii",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chinue/kimi-status-pro"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "img/logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kimiStatusPro.refresh",
        "title": "KimiStatusPro: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kimiStatusPro.signIn",
        "title": "KimiStatusPro: Sign In (OAuth)",
        "icon": "$(sign-in)"
      },
      {
        "command": "kimiStatusPro.signOut",
        "title": "KimiStatusPro: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "kimiStatusPro.setApiKey",
        "title": "KimiStatusPro: Set API Key",
        "icon": "$(key)"
      },
      {
        "command": "kimiStatusPro.showDashboard",
        "title": "KimiStatusPro: Show Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "kimiStatusPro.togglePause",
        "title": "KimiStatusPro: Toggle Pause",
        "icon": "$(debug-pause)"
      }
    ],
    "configuration": {
      "title": "KimiStatusPro",
      "properties": {
        "kimiStatusPro.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-CN"
          ],
          "default": "auto",
          "description": "Display language. Options: auto (detect from VS Code), en, zh-CN."
        },
        "kimiStatusPro.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 30,
          "description": "API refresh interval in seconds. Range: 30–∞. Long tick fetches quota from API."
        },
        "kimiStatusPro.shortRefreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Local estimation refresh interval in seconds. Range: 1–60. Short tick reads local JSONL and estimates usage without API call."
        },
        "kimiStatusPro.displayMode": {
          "type": "string",
          "enum": [
            "percent",
            "absolute"
          ],
          "default": "percent",
          "description": "Status bar display mode. percent: show percentage with mini bar. absolute: show used/limit count."
        },
        "kimiStatusPro.dataRetentionDays": {
          "type": "number",
          "default": 365,
          "minimum": 30,
          "maximum": 3650,
          "description": "Local usage data retention period in days. Range: 30–3650. Older entries are discarded during scan."
        },
        "kimiStatusPro._pauseSignal": {
          "type": "number",
          "default": 0,
          "description": "Internal: pause state broadcast signal (timestamp). Do not modify manually."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "mocha --config .mocharc.json"
  },
  "devDependencies": {
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^16.18.0",
    "@types/node-fetch": "^2.6.13",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.1",
    "chai": "^4.4.1",
    "esbuild": "^0.19.0",
    "mocha": "^10.2.0",
    "node-fetch": "^2.7.0",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
